{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["passed", "commands", "failed_tests", "log_file"],
  "properties": {
    "passed": { "type": "boolean" },
    "commands": { "type": "array", "items": { "type": "string" } },
    "failed_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "message"],
        "properties": {
          "name": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "log_file": { "type": "string" }
  },
  "additionalProperties": false
}
